---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<div class="ml-title">
  <button type="button" class="ml-nav-toggle" aria-label="收合目錄" aria-expanded="true">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
  </button>
  <Default />
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const btn = document.currentScript.previousElementSibling.querySelector('.ml-nav-toggle');
    const apply = (collapsed) => {
      if (collapsed) root.dataset.navCollapsed = '';
      else delete root.dataset.navCollapsed;
      btn.setAttribute('aria-expanded', String(!collapsed));
      btn.setAttribute('aria-label', collapsed ? '展開目錄' : '收合目錄');
    };
    let saved = false;
    try { saved = localStorage.getItem('ml-nav-collapsed') === '1'; } catch {}
    apply(saved);
    btn.addEventListener('click', () => {
      const next = !('navCollapsed' in root.dataset);
      apply(next);
      try { localStorage.setItem('ml-nav-collapsed', next ? '1' : '0'); } catch {}
    });
  })();
</script>

<style>
  .ml-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ml-nav-toggle {
    display: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
    flex: none;
  }
  .ml-nav-toggle:hover {
    background: var(--sl-color-gray-6);
  }
  /* 手機版 Starlight 已內建漢堡選單，這顆按鈕只在桌機顯示 */
  @media (min-width: 50rem) {
    .ml-nav-toggle {
      display: grid;
    }
  }
</style>
